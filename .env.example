DATABASE_PATH=./survey_assistant.sqlite3
SESSION_STORAGE_PATH=./browser-state
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
APPROVED_SURVEY_DOMAINS=survey.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_AUTH_TOKEN=replace-with-a-random-token-at-least-32-characters
DASHBOARD_AUTH_REQUIRED=true
# Set DASHBOARD_AUTH_TOKEN to a strong secret and keep auth required for remote access.
# Serve behind HTTPS and restrict inbound access with a firewall.
# Playwright validates each request's hostname and current DNS resolution, but cannot
# atomically pin DNS through the browser's resolver. Use an outbound firewall/proxy
# allowlist to prevent DNS-rebinding/TOCTOU escapes in production.
